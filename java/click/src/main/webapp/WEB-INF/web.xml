<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://jcp.org" xmlns:xsi="http://w3.org" xsi:schemaLocation="http://jcp.org http://jcp.org/web-app_4_0.xsd" version="4.0">
    <display-name>Apache Click Benchmark</display-name>
    <servlet>
        <servlet-name>ClickServlet</servlet-name>
        <servlet-class>org.apache.click.ClickServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClickServlet</servlet-name>
        <url-pattern>*.htm</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>index.htm</welcome-file>
    </welcome-file-list>
</web-app>
